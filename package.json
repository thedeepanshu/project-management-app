{
  "name": "twillboard",
  "version": "2.0.0",
  "private": true,
  "description": "Twillboard — clients and projects, woven into one board. A full-stack MERN + GraphQL project manager.",
  "type": "module",
  "workspaces": [
    "client"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch --env-file-if-exists=.env server/index.js",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "start": "node --env-file-if-exists=.env server/index.js",
    "seed": "node --env-file-if-exists=.env server/scripts/seed.js",
    "lint": "npm run lint -w client"
  },
  "author": "Deepanshu Saini",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "dataloader": "^2.2.3",
    "express": "^5.3.0",
    "graphql": "^17.0.2",
    "graphql-yoga": "^6.0.1",
    "mongoose": "^9.11.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}

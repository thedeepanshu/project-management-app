# Copy this file to .env and fill in the values. Never commit .env.

NODE_ENV=development
PORT=5000

# MongoDB Atlas → Database → Connect → Drivers. Put a database name after ".net/".
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/loomwork?retryWrites=true&w=majority

# Optional: comma-separated origins allowed to call the API from another domain.
# Not needed in development (Vite proxies /graphql) or when the API serves the app.
# CLIENT_ORIGIN=https://your-frontend.example.com

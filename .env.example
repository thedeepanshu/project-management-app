# Copy this file to .env and fill in the values. Never commit .env.

NODE_ENV=development
PORT=5000

# MongoDB Atlas → Database → Connect → Drivers. Put a database name after ".net/".
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/twillboard?retryWrites=true&w=majority

# Optional: comma-separated origins allowed to call the API from another domain.
# Not needed in development (Vite proxies /graphql and /api) or when the API serves the app.
# CLIENT_ORIGIN=https://your-frontend.example.com

# ── File uploads (optional) ───────────────────────────────────────────────
# Project attachments and client photos. Free account, no card: https://cloudinary.com
# Dashboard → "API environment variable".
CLOUDINARY_URL=

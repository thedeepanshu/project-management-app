# Copy this file to .env and fill in the values. Never commit .env.

NODE_ENV=development
PORT=5000

# MongoDB Atlas → Database → Connect → Drivers. Put a database name after ".net/".
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/twillboard?retryWrites=true&w=majority

# ── Auth (required) ───────────────────────────────────────────────────────
# Long random secret that signs sessions and encrypts OAuth tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# The URL people open in the browser. Development: the Vite dev server.
# Production: your https:// domain. Email links and OAuth callbacks use it.
APP_URL=http://localhost:5180

# Optional: extra comma-separated origins allowed to call the API cross-origin.
# CLIENT_ORIGIN=https://your-frontend.example.com

# ── Email (required in production) ────────────────────────────────────────
# Verification and password-reset emails, sent through Gmail.
# SMTP_PASS is a Gmail *app password* (needs 2-Step Verification):
#   https://myaccount.google.com/apppasswords
# Without these, development prints emails (with their links) to the terminal.
SMTP_USER=
SMTP_PASS=
# EMAIL_FROM="Twillboard <you@gmail.com>"

# ── Social sign-in (optional: each button appears once its pair is set) ────
# Redirect URI to register with each provider: <APP_URL>/api/auth/callback/<provider>
#   e.g. http://localhost:5180/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common

# ── File uploads (optional) ───────────────────────────────────────────────
# Project attachments, client photos and profile photos. Free account, no card: https://cloudinary.com
# Dashboard → "API environment variable".
CLOUDINARY_URL=
